[Unit]
Description=TranslateGemma Translation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/translate-gemma
EnvironmentFile=/data/translate-gemma/translate-gemma.env
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=TORCHINDUCTOR_COMPILE_THREADS=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=TRANSLATE_GEMMA_CHUNK_CHARS=1800
Environment=TRANSLATE_GEMMA_CHUNK_MAX_NEW_TOKENS=512
Environment=TRANSLATE_GEMMA_MAX_BATCH_SIZE=24
Environment=TRANSLATE_GEMMA_LONG_BATCH_SIZE=3
Environment=TRANSLATE_GEMMA_LOCK_WAIT_SECONDS=60
Environment=TRANSLATE_GEMMA_BATCH_WAIT_SECONDS=0.08
Environment=TRANSLATE_GEMMA_BATCH_MIN_WAIT_SECONDS=0.005
Environment=TRANSLATE_GEMMA_BATCH_MAX_CHARS=6000
Environment=TRANSLATE_GEMMA_SHORT_TEXT_CHARS=255
Environment=TRANSLATE_GEMMA_MEDIUM_TEXT_CHARS=1024
Environment=TRANSLATE_GEMMA_LONG_JOB_PROMOTE_SECONDS=3
Environment=TRANSLATE_GEMMA_QUEUE_RESULT_TIMEOUT_SECONDS=180
ExecStart=/data/translate-gemma/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
